{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["node"]
  },
  "include": [
    "types/**/*.d.ts",
    "js/**/*.js",
    "pages/**/*.js",
    "data/**/*.js"
  ],
  "exclude": ["node_modules", "dist"]
}
