/* ============ v95: الرئيسية — ترتيب مريح في وسط الشاشة + بطاقات صغيرة + مناسبات ملوّنة ============
   يتبع css/home-v94.css (يُحمَّل بعده). يضبط: عمود وسط الشاشة · شبكة الصلوات الخمس بلا سحب ·
   أيقونة لكل صلاة · أسهم شريط الأيقونات · بطاقات الآية/الدعاء/الحديث الصغيرة · بطاقات المناسبات. */

/* --- 1) عمود وسط الشاشة (مريح للعين على الشاشات الواسعة) --- */
.home-hero .hh-inner {
  width: 100%;
  max-width: 560px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.hm-wrap {
  width: 100%;
  max-width: 560px;
  margin: 0 auto;
  padding: 12px 0 26px;
}
.hm-card, .hm-media, .hm-resume, .hm-occ { margin-inline: 14px; }

/* --- 2) رأس بطاقة الصلوات: زر المدينة + زر جدول الصلوات --- */
.hm-prayers .hm-card-head { flex-wrap: wrap; row-gap: 7px; }
.hm-head-actions {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: nowrap;
  min-width: 0;
  margin-inline-start: auto;
}
.hm-head-actions .prayers-location {
  font-size: 10.5px;
  font-weight: 600;
  padding: 3px 9px;
  gap: 4px;
  max-width: 46vw;
  color: var(--text-primary, #1a1a1a);
}
.hm-head-actions .prayers-location > span {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hm-head-actions .prayers-location .fa-location-dot { color: #0F766E; font-size: 10px; }

/* --- 3) الصلوات الست (الشروق + الخمس): شبكة من ٦ أعمدة — تظهر كاملة بلا سحب --- */
.hm-prayer-grid {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 4px;
}
.hm-prayer-grid .prayer-row {
  display: flex !important;
  flex-direction: column !important;
  align-items: center;
  justify-content: flex-start;
  gap: 1px;
  grid-template-columns: none !important;
  grid-template-rows: none !important;
  margin: 0 !important;
  padding: 7px 2px 6px !important;
  border: none !important;
  border-radius: 12px;
  background: var(--color-bg-subtle, rgba(127, 127, 127, 0.08));
  box-shadow: none !important;
  min-height: 0 !important;
  min-width: 0;
}
.hm-prayer-grid .prayer-row.next {
  background: rgba(15, 118, 110, 0.14);
  box-shadow: inset 0 0 0 1.5px rgba(15, 118, 110, 0.55) !important;
}
.hm-prayer-grid .prayer-row.prayer-done { opacity: 0.72; }
.hm-pc-ic { color: #0F766E; line-height: 0; display: block; }
.hm-pc-ic svg { display: block; width: 18px; height: 18px; }
.hm-prayer-grid .hm-chip-nm { font-size: 10px; }
.hm-prayer-grid .prayer-time-block { display: flex; flex-direction: column; align-items: center; gap: 0; }
.hm-prayer-grid .prayer-time { font-size: 11px; font-weight: 700; font-variant-numeric: tabular-nums; }
.hm-prayer-grid .prayer-remaining {
  justify-content: center;
  direction: ltr;
  margin-top: 1px;
  font-size: 9px;
}
.hm-prayer-grid .hm-chip-tools { gap: 2px; margin-top: 4px; }
.hm-prayer-grid .hm-check,
.hm-prayer-grid .prayer-bell,
.hm-prayer-grid .hm-check-spacer {
  width: 18px;
  height: 18px;
  font-size: 8px;
}
.hm-prayer-grid .prayer-bell {
  border: none;
  border-radius: 50%;
  padding: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(127, 127, 127, 0.14);
  color: var(--text-secondary, #666);
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}
.hm-prayer-grid .prayer-bell.off { opacity: 0.5; }

/* الشروق — أُدخل في الشبكة نفسها (v96)، وهذه القاعدة تبقى للتوافق */
.hm-sunrise-line {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  margin-top: 9px;
  font-size: 11.5px;
  color: var(--text-secondary, #666);
}
.hm-sunrise-line svg { color: #D4AF37; }
.hm-sunrise-line b { color: var(--text-primary, #1a1a1a); font-variant-numeric: tabular-nums; }

/* --- 4) شريط الأيقونات: سهمان صغيران يدلّان على مزيد من الأيقونات --- */
.home-hero .hh-quick { position: relative; }
.home-hero .hh-quick .home-quick-grid { padding: 0 1px; }
.hh-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 25px;
  height: 25px;
  padding: 0;
  border: none;
  border-radius: 50%;
  display: none;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.26);
  color: #fff;
  font-size: 10px;
  cursor: pointer;
  z-index: 3;
  box-shadow: 0 2px 8px rgba(7, 30, 23, 0.35);
  -webkit-backdrop-filter: blur(4px);
  backdrop-filter: blur(4px);
  -webkit-tap-highlight-color: transparent;
}
.hh-arrow.show { display: inline-flex; }
.hh-arrow-start { inset-inline-start: -3px; }
.hh-arrow-end { inset-inline-end: -3px; }

/* --- 5) البطاقات الصغيرة (آية/دعاء/حديث) — كما كانت، بحجم أصغر --- */
.hm-small { padding: 12px; }
.hm-small .hm-card-head { margin-bottom: 8px; align-items: center; }
.hm-small .hm-icon-btn {
  position: static;
  width: 26px;
  height: 26px;
  font-size: 10.5px;
  flex-shrink: 0;
}
.hm-small .hm-verse-body {
  border-radius: 14px;
  padding: 11px 12px;
  margin: 0 !important;
  box-shadow: none !important;
}
.hm-small .verse-arabic {
  font-size: 15px;
  line-height: 1.9;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.hm-small .verse-translit,
.hm-small .dua-transliteration {
  font-size: 10.5px;
  opacity: 0.72;
  font-style: italic;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.hm-small .verse-divider { height: 1px; margin: 7px 0; }
.hm-small .verse-translation,
.hm-small .dua-translation {
  font-size: 12.5px;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.hm-small .verse-source,
.hm-small .dua-source { font-size: 10.5px; opacity: 0.82; margin-top: 4px; }
.hm-small .verse-wisdom {
  font-size: 11px;
  line-height: 1.5;
  margin-top: 7px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.hm-small .dua-title { font-size: 12.5px; font-weight: 700; margin-bottom: 4px; }
.hm-small .dua-arabic {
  font-size: 15px;
  line-height: 1.85;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* --- 6) تبويب المقتطفات: تنبيه اللغة + مدة المقطع --- */
.hm-pane-note {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 7px;
  font-size: 10.5px;
  font-weight: 600;
  color: var(--text-secondary, #666);
  opacity: 0.9;
}
.hm-pane-note i { font-size: 10px; color: #0F766E; }
.hm-clips-row .clip-home-thumb { position: relative; }
.hm-clip-dur {
  position: absolute;
  inset-block-end: 5px;
  inset-inline-end: 5px;
  padding: 1px 5px;
  border-radius: 6px;
  background: rgba(0, 0, 0, 0.72);
  color: #fff;
  font-size: 9.5px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  direction: ltr;
}

/* --- 7) المناسبات: مؤقّت رمضان كامل + بطاقات ملوّنة مختلفة --- */
.hm-occ { margin-bottom: 12px; }
.hm-occ-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 10px;
  margin-top: 10px;
}
.occ-card {
  border-radius: 16px;
  padding: 12px;
  color: #fff;
  overflow: hidden;
  box-shadow: 0 4px 14px rgba(15, 76, 58, 0.18);
}
.occ-head { display: flex; align-items: center; gap: 7px; }
.occ-ic {
  width: 24px;
  height: 24px;
  flex-shrink: 0;
  border-radius: 8px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.20);
  font-size: 11px;
}
.occ-title {
  flex: 1;
  min-width: 0;
  font-size: 12.5px;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.occ-btn {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  height: 24px;
  padding: 0 9px;
  border: none;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
  font-family: inherit;
  font-size: 10.5px;
  font-weight: 700;
  cursor: pointer;
  white-space: nowrap;
  -webkit-tap-highlight-color: transparent;
}
.occ-btn:active { transform: scale(0.96); }
.occ-main { margin-top: 8px; font-size: 14px; font-weight: 700; line-height: 1.4; }
.occ-meta { margin-top: 3px; font-size: 10.5px; line-height: 1.5; opacity: 0.86; }
.occ-ramadan { border: none !important; margin: 0 !important; background: linear-gradient(135deg, #0F4C3A 0%, #14795F 100%) !important; }
.occ-fast { background: linear-gradient(135deg, #0B3B5C 0%, #0E7490 100%); }
.occ-event { background: linear-gradient(135deg, #4C1D95 0%, #7C3AED 100%); }
.occ-virtue { margin-top: 10px; background: linear-gradient(135deg, #7C2D12 0%, #B45309 100%); }
.occ-card .ramadan-cd-grid { margin-top: 10px; gap: 6px; }
.occ-card .ramadan-cd-cell {
  background: rgba(255, 255, 255, 0.14);
  border: 1px solid rgba(255, 255, 255, 0.26);
  border-radius: 12px;
  padding: 7px 2px;
}
.occ-card .ramadan-cd-num { color: #fff; font-size: 20px; }
.occ-card .ramadan-cd-lbl { color: rgba(255, 255, 255, 0.86); font-size: 9.5px; }
.occ-card .ramadan-cd-dates { margin-top: 8px; gap: 6px; }
.occ-card .ramadan-cd-date {
  background: rgba(255, 255, 255, 0.14);
  border: 1px solid rgba(255, 255, 255, 0.26);
  border-radius: 12px;
  padding: 7px 6px;
  color: #fff;
  font-size: 11.5px;
}
.occ-card .ramadan-cd-date-lbl { color: rgba(255, 255, 255, 0.82); font-size: 9.5px; }

/* --- 8) شاشات صغيرة جدًا: ضغط بسيط كي تبقى الخمس ظاهرة --- */
@media (max-width: 380px) {
  .hm-prayer-grid { gap: 3px; }
  .hm-prayer-grid .prayer-row { padding: 6px 1px 5px !important; }
  .hm-prayer-grid .hm-chip-nm { font-size: 9.5px; }
  .hm-prayer-grid .prayer-time { font-size: 10.5px; }
  .hm-prayer-grid .hm-pc-ic svg { width: 16px; height: 16px; }
  .hm-prayer-grid .hm-check, .hm-prayer-grid .prayer-bell { width: 17px; height: 17px; font-size: 7.5px; }
  .hm-prayer-grid .hm-chip-tools { gap: 1px; }
}
