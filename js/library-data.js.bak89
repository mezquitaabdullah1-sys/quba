  },

  // ============ ألوان أغلفة الكتب (v1.0.78) ============
  // كل تصنيف له لوحته، وغير المعروف يأخذ لوحة بحسب اسم الكتاب — فتبدو الأرفف متنوّعة كأغلفة حقيقية.
  COVER_PALETTES: {
    emerald: ['#0B3D2E', '#14624B'],
    navy:    ['#14243F', '#27456F'],
    maroon:  ['#5A1A1E', '#7C2A2F'],
    brown:   ['#443027', '#6B4A3A'],
    teal:    ['#0A453F', '#0E6B5C'],
    indigo:  ['#251C4E', '#403277'],
    slate:   ['#2B363F', '#48606E'],
    purple:  ['#41114F', '#6A1B9A'],
    crimson: ['#5E1010', '#8E1B1B'],
    forest:  ['#16341A', '#2E5B32'],
    ochre:   ['#5E400F', '#8A6720'],
  },
  COVER_BY_CAT: {
    tafsir: 'indigo', hadith: 'navy', aqeedah: 'brown', fiqh: 'teal',
    usul: 'slate', seerah: 'forest', adhkar: 'maroon', arabic: 'purple', balagha: 'crimson',
  },
  _hash(str) {
    let h = 0; const t = String(str || '');
    for (let i = 0; i < t.length; i++) h = (h * 31 + t.charCodeAt(i)) % 100003;
    return h;
  },
  // يُرجع [داكن، أفتح] للغلاف
  coverPalette(catId, name) {
    const keys = Object.keys(this.COVER_PALETTES);
    const key = (catId && this.COVER_BY_CAT[catId]) || keys[this._hash(name) % keys.length];
    return this.COVER_PALETTES[key] || this.COVER_PALETTES.emerald;
  },

