// v1.0.83 — FEATURED يُبنى من الكتب الموثّقة (CURATED) فلا تكرار ولا معرّفات غير متحقّق منها.
(function (D) {
  const out = [], seen = {};
  Object.keys(D.CURATED).forEach(t => D.CURATED[t].forEach(b => {
    if (!b || !b.id || seen[b.id]) return;
    seen[b.id] = 1;
    out.push({ id: b.id, name: b.name, author: b.author || '', cat: t, volumes: b.volumes || 0 });
  }));
  D.FEATURED = out;
})(LibraryData);
// v1.0.84 — (١) لا نُدرج كتبًا بلا رابط PDF كي لا يُخرَج المستخدم من التطبيق.
//            (٢) إسناد أبواب الكتب الأجنبية بحسب عنوان الكتاب نفسه (إسناد شفّاف لا تلفيق).
(function (D) {
  const IHx = D.ISLAMHOUSE || {};
  ['ar', 'es', 'en'].forEach(function (l) {
    const Lx = IHx[l]; if (!Lx || !Lx.groups) return;
    Lx.groups.forEach(function (gr) { gr.books = (gr.books || []).filter(function (b) { return b && b.pdf; }); });
  });
  const KW = [
    ['qisas', ['profetas', 'prophets', 'stories of the prophets', 'historias de los profetas']],
    ['seerah', ['seerah', 'sira', 'biography', 'biografía', 'nectar', 'muhammad', 'mahoma', 'profeta']],
    ['hadith', ['hadith', 'hadiz', 'sahih', 'sunnah', 'sunna', 'bukhari', 'muslim', 'profeticas']],
    ['quran', ['quran', 'corán', 'coran', 'tafsir', 'tafseer', 'recitación', 'recitation']],
    ['aqeedah', ['aqeedah', 'aqidah', 'creed', 'belief', 'tawhid', 'monotheism', 'shahada', 'pilares de la fe']],
    ['fiqh', ['fiqh', 'prayer', 'oración', 'oracion', 'salat', 'salah', 'fasting', 'ayuno', 'ramadan', 'ramadán', 'zakat', 'limosna', 'hajj', 'peregrinación', 'ablution', 'purificación', 'purification']],
    ['adhkar', ['adhkar', 'dua', 'duas', 'invocation', 'invocación', 'dhikr', 'fortress', 'súplica']],
    ['kids', ['kids', 'child', 'children', 'niño', 'niños', 'ninos', 'infantil', 'young']],
    ['family', ['family', 'familia', 'mujer', 'women', 'matrimonio', 'marriage', 'wife', 'husband', 'padres']],
    ['arabic', ['arabic', 'árabe', 'arabe', 'grammar', 'language']],
    ['reflect', ['soul', 'alma', 'heart', 'corazón', 'espiritual', 'reflexiones']],
    ['dialogue', ['dialogue', 'diálogo', 'dialogo', 'debate', 'interfaith']]
  ];
  const KIDKW = ['kids', 'child', 'children', 'niño', 'niños', 'ninos', 'infantil', 'young'];
  function topicOf(b, groupId) {
    const t = String((b && b.name) || '').toLowerCase();
    for (let i = 0; i < KW.length; i++) { if (KW[i][1].some(function (k) { return t.indexOf(k) !== -1; })) return KW[i][0]; }
    if (groupId === 'kids') return 'kids';
    if (groupId === 'family') return 'family';
    if (groupId === 'nm' || groupId === 'basics') return 'basics';
    return groupId || 'basics';
  }
  D.ihAllBooks = function (lang) {
    const out = [], seen = {};
    (((IHx[lang] || {}).groups) || []).forEach(function (gr) {
      (gr.books || []).forEach(function (b) {
        const id = Number(b.id); if (!id || seen[id]) return; seen[id] = 1;
        out.push(Object.assign({}, b, { group: gr.id, topic: topicOf(b, gr.id), kids: (gr.id === 'kids' || KIDKW.some(function (k) { return String(b.name || '').toLowerCase().indexOf(k) !== -1; })) }));
      });
    });
    return out;
  };
  D.ihTopicBooks = function (lang, topic) { return D.ihAllBooks(lang).filter(function (b) { return b.topic === topic; }); };
})(LibraryData);

if (typeof module !== 'undefined') module.exports = LibraryData;