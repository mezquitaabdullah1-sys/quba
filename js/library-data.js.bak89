          { id: 2840115, name: "Las Bases del Musulmًan en la creencia y la adoracion1 - Español", lang: 'es', group: "nm", pdf: "https://d1.islamhouse.com/data/es/ih_books/single/es-asasiat-al-muslim-01-asban-p.pdf", page: "https://islamhouse.com/es/books/2840115/", desc: "" },
          { id: 2840113, name: "Las Bases del Musulmًan en la creencia y la adoracion 2 - Español", lang: 'es', group: "nm", pdf: "https://d1.islamhouse.com/data/es/ih_books/single/es-las-bases-del-musulman-en-02-p.pdf", page: "https://islamhouse.com/es/books/2840113/", desc: "Este libro es una referencia educativa integral que enseña al musulmán los fundamentos de su religión, incluyendo la creencia (aqidah), la ley islámica (sharia) y el estilo de vida islámico. Este enfo" },
          { id: 2829889, name: "El Adhán Un grandioso Ilamado para un rito grandioso", lang: 'es', group: "nm", pdf: "https://d1.islamhouse.com/data/es/ih_books/single/es-athan-call.pdf", page: "https://islamhouse.com/es/books/2829889/", desc: "El Adhán Un grandioso Ilamado para un rito grandioso El grandioso y excelso llamado de Al-lah que se repite en nuestros oídos cinco veces al día para que alcance los corazones, para dirigirse a los es" },
