          { id: 412596, name: "¿Guiados?", lang: 'es', group: "nm", pdf: "https://d1.islamhouse.com/data/es/ih_books/single/es_Goded.pdf", page: "https://islamhouse.com/es/books/412596/", desc: "Esta poca fiabilidad de las fuentes judeocristianas obliga a muchos investigadores sinceros a buscar la guía en otra parte. He aquí la razón para este segundo volumen de la serie. Muchos que cuestiona" },
