  // ============ IslamHouse — كتب وقفية حقيقية بمعرّفاتها وعناوينها (مُتحقّق منها) ============
  // مصادر الأغلفة: islamhouse.com/<lang>/books/<id>/. المجموعات تُعرَض حسب اللغة المختارة.
  // v1.0.87 — مكتبة IslamHouse العربية: روابط مُتحقّق منها (HTTP 200 + application/pdf + Access-Control-Allow-Origin: *)
  // المصدر: islamhouse.com/ar/books/<id>/ — تُخزَّن داخل التطبيق وتُقرأ بلا إنترنت بعد أول فتح.
  ISLAMHOUSE: {
    ar: { groups: [
      { id: "ar_nm", icon: "fa-seedling", color: "#0F4C3A", name: {"ar": "ما يلزم المسلم", "es": "Lo que el musulmán debe conocer", "en": "What a Muslim must know"}, books: [
        { id: 2808054, name: "كيف تستعد للجمعة؟", lang: 'ar', group: "ar_nm", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_010/ar_Keef_tst3d_llgm3h.pdf", page: "https://islamhouse.com/ar/books/2808054/", desc: "كيف تستعد للجمعة؟ : رسالة موجهة للخطباء والمصلين والمستمعين تبين بعض خصائص وفضائل يوم الجمعة، مع بيان كيفية الاستعداد لصلاة الجمعة." },
        { id: 2828179, name: "مسؤولية طالب العلم", lang: 'ar', group: "ar_nm", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_02/ar-maswuwliat-talab-al3ilm.pdf", page: "https://islamhouse.com/ar/books/2828179/", desc: "مسؤولية طالب العلم : كتيب لفضيلة الشيخ عبد العزيز بن باز - رحمه الله -، تحدث فيه مسؤولية طالب العلم تجاه نفسه من جهة إعداد النفس للتعليم والدعوة، وأداء الواجب، ومن جهة العناية بالعلم والتفقه في الدين،" },
        { id: 2828162, name: "الممتاز من رسائل الإمام ابن باز", lang: 'ar', group: "ar_nm", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_02/ar-almumtaz-min-rasayil-alimam-abn-baz.pdf", page: "https://islamhouse.com/ar/books/2828162/", desc: "الممتاز من رسائل الإمام ابن باز : كتاب قيم عبارة عن مجموعة رسائل الإمام عبد العزيز بن باز - رحمه الله -، سواء كانت رسائل محررة أو محاضرات طُبعت في حياته وقد أقرها - رحمه الله -، وقد قام بجمع هذا الكتا" },
        { id: 2828089, name: "التعليقات البازية على زاد المعاد", lang: 'ar', group: "ar_nm", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_09/ar-altaeliqat-albaziah-3alaa-zad-almaead.pdf", page: "https://islamhouse.com/ar/books/2828089/", desc: "التعليقات البازية على زاد المعاد : كتاب قيّم فيه تعليق الشيخ العلامة عبد العزيز بن باز - رحمه الله - على بعض الفصول من كتاب زاد المعاد في هدي خير العباد - صلى الله عليه وسلم -، لابن قيم الجوزية - رحمه" },
        { id: 420257, name: "حصاد العام", lang: 'ar', group: "ar_nm", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single7/ar_7sad_Al3am.pdf", page: "https://islamhouse.com/ar/books/420257/", desc: "بيان أهمية استغلال هذه الحياة في الأعمال الصالحة." },
        { id: 420166, name: "إن سعيكم لشتى", lang: 'ar', group: "ar_nm", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single7/ar_in_s3eekm_lshtee.pdf", page: "https://islamhouse.com/ar/books/420166/", desc: "فلقد اقتضت حكمة الله تعالى أن يجعل في الأرض خليفةً ليعمر الأرض، ويقوم بالوظيفة التي من أجلها خُلق، ويُؤدِّي الأمانة التي تحمَّلها، وكان لا بدَّ من طريق يسلكه هذا الخليفة حتى يصل إلى مقصوده، ليظفر بمطل" },
        { id: 420131, name: "أخلاق الإسلام", lang: 'ar', group: "ar_nm", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single7/ar_akhlaq_AlIslam.pdf", page: "https://islamhouse.com/ar/books/420131/", desc: "فإن الله سبحانه وتعالى ما بعث الرسل - عليهم السلام - إلا لإتمام الأخلاق بعد توحيده وعبادته فعنه - صلي الله عليه وسلم - أنه قال:{إنما بُعثت لأتمم صالح الأخلاق}، وفي هذا الكتيب بيان بعض أخلاق الإسلام." },
      ]},
      { id: "ar_dawah", icon: "fa-bullhorn", color: "#8A6720", name: {"ar": "الدعوة إلى الله وتعريف الإسلام", "es": "La predicación y la presentación del Islam", "en": "Calling to Islam"}, books: [
        { id: 2831443, name: "المختصر المفيد للمسلم الجديد", lang: 'ar', group: "ar_dawah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_010/ar-almukhtasar-almufid-lilmuslim-aljadid-m-ashihriy-ppp.pdf", page: "https://islamhouse.com/ar/books/2831443/", desc: "كتاب نافع باللغة العربية، موجه خصيصًا إلى المسلم الجديد الذي يحتاج إلى معرفة أسس الإسلام معرفة صحيحة، والدليل مبني على طريقة الأدلة التعليمية، مُراعيًا جميع المسائل الفقهية والإشكالات العقدية والمصطلح" },
        { id: 2830560, name: "شرح الدروس المهمة لعامة الأمة", lang: 'ar', group: "ar_dawah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_09/ar-shar7-aldoros-almohemah-alkhoder.pdf", page: "https://islamhouse.com/ar/books/2830560/", desc: "كتاب نافع عبارة عن شرح لرسالة العلامة الشيخ عبد العزيز بن باز رحمه الله تعالى، لفضيلة الشيخ عبد الكريم بن عبد الله الخضير أثابه الله، وقد جمع المُصَنِّف رحمه الله بين دفَّتَيه سائر العلوم الشرعية من أ" },
        { id: 2838784, name: "الإسلام دين رب العالمين", lang: 'ar', group: "ar_dawah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single/risala_ar_islamdinrabb.pdf", page: "https://islamhouse.com/ar/books/2838784/", desc: "كتاب نافع يوضح أن الإسلام هو الدين الحق وهو دين رب العالمين الذي ارتضاه للناس." },
        { id: 2838782, name: "الإسلام دين الفطرة والعقل والسعادة", lang: 'ar', group: "ar_dawah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_010/ar-alislam-deen-alfitrah.pdf", page: "https://islamhouse.com/ar/books/2838782/", desc: "كتاب قيم يوضح أن الإسلام هو دين الفطرة والعقل والسعادة." },
        { id: 2838780, name: "الإسلام دين رسل الله", lang: 'ar', group: "ar_dawah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single3/ar-aliislam-din-rusul-allah.pdf", page: "https://islamhouse.com/ar/books/2838780/", desc: "كتاب قيم يوضح أن الإسلام هو دين الأنبياء والرسل جميعا." },
        { id: 420080, name: "عزيزي الإنسان! - عربي", lang: 'ar', group: "ar_dawah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single7/ar_ensan.pdf", page: "https://islamhouse.com/ar/books/420080/", desc: "عزيزي الإنسان ..... أخاطبك من حيث أنت إنسان .... لا يهم إن كنت مسيحيا أو يهوديا .... بوذيا أو هندوسيا .... عابدا\r\nللأصنام أو ملحدا .... متدينا أوعلمانيا .... امرأة أو رجلا .....\r\nأخاطبك وأكلمك من حيث " },
      ]},
      { id: "ar_aqeedah", icon: "fa-star-and-crescent", color: "#6D4C41", name: {"ar": "العقيدة والتوحيد", "es": "Creencia y Tawhid", "en": "Creed & Tawhid"}, books: [
        { id: 2832015, name: "حماية الرسول صلى الله عليه وسلم حمى التوحيد", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_010/ar-hameayat-alrasol.pdf", page: "https://islamhouse.com/ar/books/2832015/", desc: "بحث بين فيه مؤلفه - أثابه الله - :\r\n1- معني التوحيد.\r\n2- نماذج من دعوة الأنبياء والرسل عليهم الصلاة والسلام.\r\n3-دعوة النبي محمد - صلى الله عليه وسلم -.\r\n4-أنواع التوحيد، وأنواع الشرك.\r\n5-منهج الرسول م" },
        { id: 2831772, name: "أصول عظيمة من قواعد الإسلام", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_09/ar-osol-3azemah.pdf", page: "https://islamhouse.com/ar/books/2831772/", desc: "أصول عظيمة من قواعد الإسلام: فهذه دُرَّةٌ فريدة وتُحفة جديدة من دُرر وفوائد العلامة عبد الرحمن بن ناصر السعدي - رحمه الله تعالى - النفيسة ، .. وبناها على خمس قواعد عظيمة عليها قيام هذا الدين، وبسطَ ال" },
        { id: 2831673, name: "إتحاف النبيل بأحكام التماثيل", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_09/ar-ahkam-altamasel.pdf", page: "https://islamhouse.com/ar/books/2831673/", desc: "إتحاف النبيل بأحكام التماثيل : كتيب نافع ذكر فيه مؤلفه - أثابه الله - الحكم الشرعي في التماثيل والمجسمات التي انتشرت في كثير من بيوت المسلمين ومكاتبهم ومراكبهم وأماكنهم الخاصة والعامة." },
        { id: 2831635, name: "قاموس الأسماء الحسنى", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_010/ar-alasmaa-alhosnaa.pdf", page: "https://islamhouse.com/ar/books/2831635/", desc: "قاموس نافع من إعداد مركز رواد الترجمة، يحتوي على قواميس باللغة العربية  عن أسماء الله وصفاته، لتكون معينا للمترجم والمراجع على الوقوف على فهم معاني أسماء الله وصفاته، ومعرفة مواضع الخطأ، وكاشفة له عن " },
        { id: 2826502, name: "المناهج الدراسية - التوحيد - عربي", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/chain/ar_almanaheg_alta3elemeah/ar_01_Manhag_Altawheed.pdf", page: "https://islamhouse.com/ar/books/2826502/", desc: "كتاب عبارة عن تهذيب واختصار لمنهج التوحيد، وهو ضمن المناهج الدراسية في المملكة العربية السعودية الموجهة للطلاب، وتم التعديل عليها يسيرًا بحيث يمكن الاستفادة منها في أي مكان، وهي مُقسمة إلى اثني عشرة (" },
        { id: 2826054, name: "كيف نحقق التوحيد", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_010/ar_kaif_nohaqeq_altawhed.pdf", page: "https://islamhouse.com/ar/books/2826054/", desc: "كيف نحقق التوحيد: كتاب قيّم لفضيلة الشيخ عبد العزيز بن باز - رحمه الله -، يبين فيه وجوب عبادة الله وحده، وكيفيه تحقيق التوحيد لله - عز وجل -، مع بيان أنواع التوحيد، ونواقض الإسلام، وغير ذلك من المواضي" },
        { id: 2826050, name: "سبل السلام شرح نواقض الإسلام", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_010/ar_sobl_eslam_shar7_nawaqed_elislam.pdf", page: "https://islamhouse.com/ar/books/2826050/", desc: "سبل السلام شرح نواقض الإسلام: كتاب نافع عبارة عن شرح لنواقض الإسلام العشر لشيخ الإسلام محمد بن عبد الوهاب - رحمه الله -، بشرح الشيخ عبد العزيز بن عبد الله بن باز - رحمه الله -." },
        { id: 2826049, name: "رسالة في التبرك والتوسل والقبور", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_010/ar_resalah_fe_altabarok_wa_tawasol.pdf", page: "https://islamhouse.com/ar/books/2826049/", desc: "رسالة في التبرك والتوسل والقبور: كتاب قيّم لفضيلة الشيخ عبد العزيز بن باز - رحمه الله -، عبارة عن رسالة مختصرة قيمة في بيان مسائل التوسل والتبرك، وبيان الممنوع منها من المحظور، ويليها بعض الفتاوى المه" },
        { id: 2826046, name: "شرح الصدور بفتاوى القبور", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_010/ar_charh_sodour.pdf", page: "https://islamhouse.com/ar/books/2826046/", desc: "شرح الصدور بفتاوى القبور: كتاب لسماحة الشيخ عبد العزيز بن باز - رحمه الله -، عبارة عن مجموعة من الفتاوى التي أجاب عنها سماحة الشيخ في مسائل مهمة متعلقة بالموتي والمقبورين." },
        { id: 2826041, name: "الدين الخالص", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_010/ar_aldeen_alkhales.pdf", page: "https://islamhouse.com/ar/books/2826041/", desc: "الدين الخالص:  كتيب قيم لفضيلة العلامة الشيخ عبد العزيز بن باز - رحمه الله -، تكلم فيه عن حقيقة التوحيد، وتعريفه، وأنواعه، وغيرها من الموضوعات الهامة." },
        { id: 2826004, name: "شرح أصول الإيمان", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_010/ar_sharh_osol_aliman_elsa3dy.pdf", page: "https://islamhouse.com/ar/books/2826004/", desc: "شرح أصول الإيمان، كتاب عبارة عن شرح الشيخ عبد الرحمن بن ناصر السعدي - رحمه الله -، لكتاب أصول الإيمان لشيخ الإسلام محمد بن عبد الوهاب - رحمه الله -." },
        { id: 2826002, name: "أصول الدين", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_010/ar_osol_din.pdf", page: "https://islamhouse.com/ar/books/2826002/", desc: "أصول الدين : كتيب قيّم لفضيلة الشيخ عبد الرحمن بن ناصر السعدي - رحمه الله -، يبين فيه أصول الدين الإسلامي." },
        { id: 2825999, name: "التوضيح والبيان لشجرة الإيمان", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_010/ar_eltawdih_wa_elbayan.pdf", page: "https://islamhouse.com/ar/books/2825999/", desc: "التوضيح والبيان لشجرة الإيمان : كتيب باللغة العربية؛ للعلامة السعدي - رحمه الله -، ذَكَر فيه مباحث الإيمان مستمدة من الكتاب والسنة، وعقده في ثلاثة فصول، بين فيها: حد الإيمان وتفسيره، بعض الأمور التي ي" },
        { id: 2841154, name: "طريق الهجرتين وباب السعادتين", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single4/ar-tariq-alhijratayn-wabab-alsaeadatayn.pdf", page: "https://islamhouse.com/ar/books/2841154/", desc: "طريق الهجرتين وباب السعادتين هو كتاب لابن قيم الجوزية، عن الإيمان والعقيدة، وقد رآه متمثلاً في طريقين\r\n\r\nالأول: الهجرة إلى الله بالعبودية والتوكل والإنابة والتسليم والخوف والرجاء،\r\n\r\nالثاني: الهجرة إل" },
        { id: 2841149, name: "هداية الحيارى في أجوبة اليهود والنصارى", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single4/ar-hidayat-alhayaraa.pdf", page: "https://islamhouse.com/ar/books/2841149/", desc: "كتاب من تأليف ابن القيم يعرض فيه لما اسماه جوانب التحريف في المسيحية واليهودية مستشهدا لكل ما يذهب إليه بنصوص من الكتب المسيحية واليهودية، وفيه رد على انتقاداتهم لرسول الإسلام ومدافعاً عنه ومبيناً حجت" },
        { id: 2808057, name: "دليل المسلم: عقيدة - عبادات - معاملات", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_010/ar_Dleel_AlMuslim.pdf", page: "https://islamhouse.com/ar/books/2808057/", desc: "دليل المسلم : رسالة قدم لها الشيخ ابن جبرين - رحمه الله - بين فيها مؤلفها - أثابه الله - ما ينبغي على المبتدئ والمسلم الجديد معرفته والعلم به في العقائد والعبادات والمعاملات." },
        { id: 193646, name: "نور التقوى وظلمات المعاصي", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_01/ar_Noor_Altaqwa.pdf", page: "https://islamhouse.com/ar/books/193646/", desc: "نور التقوى وظلمات المعاصي : كتاب باللغة العربية؛ للدكتور سعيد القحطاني - أثابه الله - بين فيه مفهوم التقوى، ومفهومها، وأهميتها، وصفات المتقين، وثمرات التقوى، كما بين فيه بعض أسباب المعاصي، ومداخلها، و" },
        { id: 2838783, name: "من خلق الكون؟ ومن خلقني؟", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_01/ar-man-khalaq-alkawn.pdf", page: "https://islamhouse.com/ar/books/2838783/", desc: "كتاب قيم يوضح أن الله عز وجل هو خالق الكون وهو خالق البشر وهو وحده الذي يستحق العبادة." },
        { id: 2838778, name: "من خلقني؟ ولماذا؟ كل شيء يدل على وجود الخالق", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_01/ar-man-khalaqni-wa-lemaza.pdf", page: "https://islamhouse.com/ar/books/2838778/", desc: "كتاب قيم يوضح أن الله هو من خلق الإنسان ويبين الغاية من خلق الناس ويوضح أن كل شيء يدل على وجود الخالق." },
        { id: 2838777, name: "فقه الفتن", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_010/ar-fiqh-alfitan-654.pdf", page: "https://islamhouse.com/ar/books/2838777/", desc: "كتاب قيم يتضمن بحثا يحتوي على تعريف القتن وأسبابها وخطورتها وبعض طرق علاج الفتن." },
        { id: 2838775, name: "شرح عقيدة الإمام المجدد محمد بن عبد الوهاب", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_010/ar-sharh-eaqidat-al-iimam-almujadad.pdf", page: "https://islamhouse.com/ar/books/2838775/", desc: "كتاب نافع يتحدث عن عقيدة الشيخ الإمام محمد بن عبد الوهاب - رحمه الله -." },
        { id: 2838774, name: "شرح السنة للبربهاري", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_010/ar-756679-sharh-alsunat-lilbirbharii.pdf", page: "https://islamhouse.com/ar/books/2838774/", desc: "كتاب ومتن قيم وهو شرح السنة للإمام أبي محمد الحسن بن علي بن خلف البربهاري - رحمه الله - المتوفى سنة 329 هـ، والذي قرر فيه منهج أهل السنة والجماعة في المسائل العقدية، فيما يتعلق بذات الله وأسمائه وصفات" },
        { id: 2838771, name: "مناهج اللغويين في تقرير العقيدة إلى نهاية القرن الرابع الهجري", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_010/ar-manahij-allughawiiyn-fi-taqrir-aleaqida.pdf", page: "https://islamhouse.com/ar/books/2838771/", desc: "كتاب نافع يشرح مناهج اللغويين في تقرير العقيدة إلى نهاية القرن الرابع الهجري." },
        { id: 2838767, name: "المنتقى من كتاب التذكرة بأحوال الموتى وأمور الآخرة", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_010/ar-almuntaqaa-min-kitab-altadhkira.pdf", page: "https://islamhouse.com/ar/books/2838767/", desc: "كتاب قيم ينتقي فيه الكاتب بعض الفوائد من كتاب التذكرة بأحوال الموتى وأمور الآخرة للإمام أبي عبد الله القرطبي -رحمه الله-." },
        { id: 2838766, name: "خصائص المصطفى صلى الله عليه وسلم بين الغلو والجفاء", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_010/ar-khasayis-almustafaa-bin-alghlow-wal-jafaa.pdf", page: "https://islamhouse.com/ar/books/2838766/", desc: "كتاب قيم يتحدث خصائص المصطفى صلى الله عليه وسلم بين الغلو والجفاء." },
        { id: 2838760, name: "وكل بدعة ضلالة", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_010/ar-wakulu-badeat-dalala-1845.pdf", page: "https://islamhouse.com/ar/books/2838760/", desc: "كتاب قيم يتحدث فيه المؤلف عن البدعة حدها وأنواعها وخطورتها مع الأمثلة." },
        { id: 2828127, name: "مدارج السالكين في منازل السائرين", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single-03/ar-Madarij-alSalikee-01.pdf", page: "https://islamhouse.com/ar/books/2828127/", desc: "مدارج السالكين : كتاب في أحوال السلوك وطريق السير إلى الله؛ للإمام ابن القيم - رحمه الله - ألفه بعد أن سأله جماعة من أهل هراة عن رغبتهم في الوقوف على منازل السائرين إلى الله، فأجابهم في ذلك، وجعله مائ" },
        { id: 420241, name: "قصة موسى عليه السلام مع فرعون بين القرآن والتوراة [ دراسة مقارنة ]", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single7/ar_Mosa_and_Fer3wn.pdf", page: "https://islamhouse.com/ar/books/420241/", desc: "قال الباحث - وفقه الله -: «بيَّنت في هذه الدراسة قصة موسى - عليه السلام - مع الطاغية فرعون في كلٍّ من القرآن والتوراة، وقمتُ بعقد مُقارنةٍ بين أحداث القصة في الكتابين، مُبيِّنًا أن التوراة تتفق مع الق" },
        { id: 420139, name: "على الباغي تدور الدوائر", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single7/ar_3lee_AlBaghee_tdur_AdDwaer.pdf", page: "https://islamhouse.com/ar/books/420139/", desc: "هذا الكتاب يحتوي على مجموعة من القصص في ذم البغي والظلم وسوء عاقبته." },
        { id: 420138, name: "الفرقان بين الهدى والضلال", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single7/ar_AlFurqan_been_AlHdee_waldlal.pdf", page: "https://islamhouse.com/ar/books/420138/", desc: "هذا الكتيب يحتوي على النقاط التالية: • الفرق بين الهدى والضلال. • لمحات من حياة الأتقياء. • أسباب السعادة. • وقفة وتأمل. • لقاء مع تائب." },
        { id: 420071, name: "المفرقون بين الأحبة [ عن النميمة ]", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single7/ar_AlMfrqun_been_AlA7bt.pdf", page: "https://islamhouse.com/ar/books/420071/", desc: "كتيب مختصر يبين أسباب النميمة وأضررها، وبعض عقوباتها، وكيفية معالجتها." },
        { id: 244204, name: "نونية القحطاني - عربي", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single4/ar_Nooni_Text_Of_Kahatany.pdf", page: "https://islamhouse.com/ar/books/244204/", desc: "نونية القحطاني من أروع المنظومات في العقيدة وأصول الدين والأحكام الشرعية والأخلاق، وأسهلها للحفظ، وأعذبها عبارة، وقد حوت أكثر مباحث العقيدة والتوحيد والأحكام الفقهية." },
        { id: 244085, name: "فصل المقال في رفع عيسى حياً ونزوله وقتله الدجال", lang: 'ar', group: "ar_aqeedah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single2/ar_fasl_maqal_in_Raising_Jesus_is_alive.pdf", page: "https://islamhouse.com/ar/books/244085/", desc: "فصل المقال في رفع عيسى حياً ونزوله وقتله الدجال : منذ مطلع هذا القرن أو قبله وجدت جماعة تدعو إلى التحرر الفكري وتتصدر حركة الإصلاح الديني وتعمل لإحياء المفاهيم الدينية الصحيحة في نفوس المسلمين ولكنهم " },
      ]},
      { id: "ar_quran", icon: "fa-book-quran", color: "#251C4E", name: {"ar": "القرآن وعلومه والتفسير", "es": "Corán, Tafsir y sus ciencias", "en": "Quran & Tafsir"}, books: [
        { id: 2826478, name: "المناهج الدراسية - التفسير - عربي", lang: 'ar', group: "ar_quran", pdf: "https://d1.islamhouse.com/data/ar/ih_books/chain/ar_almanaheg_alta3elemeah/ar_01_eltafser.pdf", page: "https://islamhouse.com/ar/books/2826478/", desc: "كتاب عبارة عن تهذيب واختصار لمنهج التفسير، وهو ضمن المناهج الدراسية في المملكة العربية السعودية الموجهة للطلاب، وتم التعديل عليها يسيرًا بحيث يمكن الاستفادة منها في أي مكان، وهي مُقسمة إلى مُسْتَوَيَي" },
        { id: 2826475, name: "المناهج الدراسية - علوم القرآن - عربي", lang: 'ar', group: "ar_quran", pdf: "https://d1.islamhouse.com/data/ar/ih_books/chain/ar_almanaheg_alta3elemeah/ar_3lom_alquran.pdf", page: "https://islamhouse.com/ar/books/2826475/", desc: "كتاب عبارة عن تهذيب واختصار لمنهج علوم القرآن، وهو ضمن المناهج الدراسية في المملكة العربية السعودية الموجهة للطلاب، وتم التعديل عليها يسيرًا بحيث يمكن الاستفادة منها في أي مكان." },
        { id: 193674, name: "أنه الحق - عربي", lang: 'ar', group: "ar_quran", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single2/ar_that_the_right.pdf", page: "https://islamhouse.com/ar/books/193674/", desc: "أنه الحق : يضم هذا الكتاب أربع عشرة مقابلة مع علماء كونيين في مختلف التخصصات، حيث كان الغرض من هذه المقابلات معرفة الحقائق العلمية التي أشارت إليها بعض الآيات القرآنية، مع بيان أن دين الإسلام حث على ا" },
        { id: 420069, name: "شرح مقدمة في أصول التفسير لابن تيمية", lang: 'ar', group: "ar_quran", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single7/ar_shr7_mqdmt_fee_asul_Tfseer.pdf", page: "https://islamhouse.com/ar/books/420069/", desc: "هذه المقدمة من نفائس ما كتبه شيخ الإسلام ابن تيمية - رحمه الله -، فقد ذكر فيها قواعد نافعة لفهم أصول التفسير، وهي صغيرة الحجم، تقع في 46 صفحة بحسب مجموع الفتاوى في الجزء رقم 13 من ص 329 حتى ص 375. وقد" },
      ]},
      { id: "ar_hadith", icon: "fa-quote-right", color: "#14243F", name: {"ar": "الحديث وعلومه", "es": "Hadiz y sus ciencias", "en": "Hadith"}, books: [
        { id: 2839210, name: "المنتقى من موسوعة الأحاديث النبوية", lang: 'ar', group: "ar_hadith", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single2/ar-almontka-mn-alhadeth.pdf", page: "https://islamhouse.com/ar/books/2839210/", desc: "موسوعة منتقاة من من الأحاديث النبوية المهمة التي تغطي مختلف جوانب الحياة، بدءًا من العقائد، وختامًا بالأدعية والأذكار ، ويهدف هذا الكتاب إلى شرح وتفسير الأحاديث النبوية، وتوضيح معانيها ودلالاتها، وتوج" },
        { id: 2826495, name: "المناهج الدراسية - علم الحديث - عربي", lang: 'ar', group: "ar_hadith", pdf: "https://d1.islamhouse.com/data/ar/ih_books/chain/ar_almanaheg_alta3elemeah/ar_01_manhag_Alhadeth.pdf", page: "https://islamhouse.com/ar/books/2826495/", desc: "كتاب عبارة عن تهذيب واختصار لمنهج علم الحديث، وهو ضمن المناهج الدراسية في المملكة العربية السعودية الموجهة للطلاب، وتم التعديل عليها يسيرًا بحيث يمكن الاستفادة منها في أي مكان، وهي مُقسمة إلى ثماني (8" },
        { id: 2838773, name: "تدوين السنة النبوية", lang: 'ar', group: "ar_hadith", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_010/ar-tadwin-alsuna-alnabawia-74.pdf", page: "https://islamhouse.com/ar/books/2838773/", desc: "كتاب قيم يتحدث عن تدوين السنة النبوية نشأته وتطوره من القرن الأول إلى القرن التاسع الهجري." },
        { id: 2828214, name: "أبرز الطعون المعاصرة في الجامع الصحيح للبخاري", lang: 'ar', group: "ar_hadith", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_02/ar-abraz-altueun-almueasirat-fi-sahih-lilbakharii.pdf", page: "https://islamhouse.com/ar/books/2828214/", desc: "أبرز الطعون المعاصرة في الجامع الصحيح للبخاري : كتاب باللغة العربية؛ جمع أبرز الشبهات المعاصرة حول صحيح البخاري، مع الرد عليها بأسلوب سهل ومختصر." },
      ]},
      { id: "ar_fiqh", icon: "fa-scale-balanced", color: "#0A453F", name: {"ar": "الفقه والعبادات", "es": "Fiqh y adoración", "en": "Fiqh & worship"}, books: [
        { id: 2826088, name: "المناهج الدراسية - علم الفقه - عربي", lang: 'ar', group: "ar_fiqh", pdf: "https://d1.islamhouse.com/data/ar/ih_books/chain/ar_almanaheg_alta3elemeah/ar_01_elfaqh.pdf", page: "https://islamhouse.com/ar/books/2826088/", desc: "هذه المادة العلمية من المناهج الدراسية في المملكة العربية السعودية الموجهة للطلاب، وتم التعديل عليها يسيرا بحيث يمكن الاستفادة منها في أي مكان، وهي مُقسمة إلى اثنتي عشرة (12) مستوى حسب السنوات الدراسي" },
        { id: 2825954, name: "تيسير الفقه", lang: 'ar', group: "ar_fiqh", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_01/ar_Tisir_Alfkh.pdf", page: "https://islamhouse.com/ar/books/2825954/", desc: "تيسير الفقه : كتاب للدكتور صالح السدلان - رحمه الله - تناول فيه ما يهم المسلم الموجود في مجتمعات غير عربية من مسائل الفقه الإسلامي الموافقة لصريح الكتاب، وصحيح السنة." },
        { id: 2841145, name: "جلاء الأفهام في فضائل الصلاة والسلام على خير الأنام", lang: 'ar', group: "ar_fiqh", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single/ar-jala-alafham.pdf", page: "https://islamhouse.com/ar/books/2841145/", desc: "هذا كتاب سميته جلاء الإفهام في فضل الصلاة والسلام على محمد خير الأنام، وهو خمسة أبواب وهو كتاب فرد في معناه لم نسبق إلى مثله في كثره فوائده وغزارتها بينا فيه الأحاديث الواردة في الصلاة والسلام عليه ﷺ " },
        { id: 2807935, name: "تعاليم الصلاة بأسلوب سهل ومختصر", lang: 'ar', group: "ar_fiqh", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_010/ar_T3aleem_AlSlah.pdf", page: "https://islamhouse.com/ar/books/2807935/", desc: "تعاليم الصلاة بأسلوب سهل ومختصر : كتيب يبين فضل الصلاة وأهميتها، مع بيان كيفية الوضوء، وصفة الصلاة بأسلوب سهل ومختصر يقوم على الأحاديث الصحيحة والأقوال الراجحة." },
        { id: 2838764, name: "التسبيح في الكتاب والسنة", lang: 'ar', group: "ar_fiqh", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_010/ar-altasbih-min-alkitab-walsuna.pdf", page: "https://islamhouse.com/ar/books/2838764/", desc: "كتاب ماتع يتحدث عن التسبيح في الكتاب والسنة والرد على المفاهيم الخاطئة فيه." },
        { id: 2838762, name: "الأحكام المترتبة على الفسق في الفقه الإسلامي", lang: 'ar', group: "ar_fiqh", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_010/ar-al-ahkam-almutaratibat-ealaa-alfisq-fi-alfiqh-al-iislamii.pdf", page: "https://islamhouse.com/ar/books/2838762/", desc: "كتاب فقهي يتناول الأحكام المترتبة على الفسق في الفقه الإسلامي." },
        { id: 2828213, name: "زاد جلسة الإشراق", lang: 'ar', group: "ar_fiqh", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_02/ar-zad-jalsat-aliishraq.pdf", page: "https://islamhouse.com/ar/books/2828213/", desc: "زاد جلسة الإشراق : من السنن المحفوظة سنة الجلوس في المسجد إلى حين إشراق الشمس؛ وهي سنة ثابتة، دأب عليها رسول الله - صلى الله عليه وسلم - وصحابته، وسلف الأمة، وفي هذا الكتاب بيان بعض أحكام جلسة الإشراق" },
        { id: 2828182, name: "من عبد العزيز بن باز إلى حجاج بيت الله الحرام", lang: 'ar', group: "ar_fiqh", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_02/ar-iilaa-hujaj-bayt-allah-alhram.pdf", page: "https://islamhouse.com/ar/books/2828182/", desc: "من عبد العزيز بن باز إلى حجاج بيت الله الحرام : كتاب قيّم لفضيلة الشيخ عبد العزيز بن باز - رحمه الله -، عبارة عن مجموعة من النصائح والرسائل لحجاج بيت الله، ومعه بعض الأختيارات الفقهية لفضيلة الشيخ - ر" },
        { id: 2828172, name: "فتاوى عن صلاة الفجر", lang: 'ar', group: "ar_fiqh", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_02/ar-fatawaa-3an-salat-alfajr.pdf", page: "https://islamhouse.com/ar/books/2828172/", desc: "فتاوى عن صلاة الفجر : كتيب لسماحة الشيخ عبد العزيز بن باز - رحمه الله -، يبين فيه أهمية الصلاة، ووجوب المحافظة عليها، ويحيب فيه على بعض التساؤلات حول صلاة الفجر، وحكم تركها أو تأخيرها." },
        { id: 2828161, name: "المختار من فتاوي الأئمة الأعلام - عربي", lang: 'ar', group: "ar_fiqh", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_02/ar-almukhtar-min-fattawi-alayimah-alaelam.pdf", page: "https://islamhouse.com/ar/books/2828161/", desc: "المختار من فتاوي الأئمة الأعلام : كتاب نافع جمع فيه مؤلفه - أثابه الله - مختارات من فتاوى اللجنة الدائمة للبحوث العلمية والأفتاء من (37) مجلد من فتاوى اللجنة الدائمة." },
        { id: 2828116, name: "نيل المراد في تحقيق سفرة الزاد لسفرة الجهاد", lang: 'ar', group: "ar_fiqh", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_02/ar_Safarat_alzad.pdf", page: "https://islamhouse.com/ar/books/2828116/", desc: "نيل المراد في تحقيق سفرة الزاد لسفرة الجهاد : كتاب باللغة العربية؛ للعلامة الآلوسي - رحمه الله - بين فيه بعض فضائل الجهاد." },
      ]},
      { id: "ar_usul", icon: "fa-gavel", color: "#3E2723", name: {"ar": "أصول الفقه", "es": "Fundamentos de la jurisprudencia", "en": "Principles of Fiqh"}, books: [
        { id: 2826042, name: "الشريعة الإسلامية ومحاسنها وضرورة البشر إليها", lang: 'ar', group: "ar_usul", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_010/ar_alshare3a_alislamia_wa_ma7asnaha.pdf", page: "https://islamhouse.com/ar/books/2826042/", desc: "كتاب نافع لفضيلة الشيخ عبد العزيز بن باز - رحمه الله -، يتحدث فيه  عن الشريعة الإسلامية ومحاسنها وضرورة البشر إليها، ويبين فيه ايضًا أن جميع الرسل - عليهم الصلاة والسلام - كلهم أرسلوا بالإسلام، وكلهم " },
        { id: 244320, name: "الورقات في أصول الفقه", lang: 'ar', group: "ar_usul", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single-03/ar-alwaraqat.pdf", page: "https://islamhouse.com/ar/books/244320/", desc: "الورقات هو متن مختصر جدًّا تكلم فيه المؤلف رحمه الله على خمسة عشر بابًا من أبواب أصول الفقه، وهي: أقسام الكلام، الأمر، النهي، العام والخاص، المجمل والمبين، الظاهر والمؤول، الأفعال، الناسخ والمنسوخ، ال" },
      ]},
      { id: "ar_seerah", icon: "fa-book", color: "#16341A", name: {"ar": "السيرة والتاريخ والقصص", "es": "Sira, historia y relatos", "en": "Seerah & history"}, books: [
        { id: 2826477, name: "المناهج الدراسية - السيرة النبوية - عربي", lang: 'ar', group: "ar_seerah", pdf: "https://d1.islamhouse.com/data/ar/ih_books/chain/ar_almanaheg_alta3elemeah/ar_01_alsera_alnabawia.pdf", page: "https://islamhouse.com/ar/books/2826477/", desc: "كتاب عبارة عن تهذيب واختصار لمنهج السيرة النبوية، وهو ضمن المناهج الدراسية في المملكة العربية السعودية الموجهة للطلاب، وتم التعديل عليها يسيرًا بحيث يمكن الاستفادة منها في أي مكان، وهي مُقسمة إلى أربع" },
      ]},
      { id: "ar_adhkar", icon: "fa-heart", color: "#5A1A1E", name: {"ar": "الأذكار والرقائق", "es": "Espiritualidad y elocuencia", "en": "Remembrance & spirituality"}, books: [
        { id: 2841153, name: "عدة الصابرين وذخيرة الشاكرين", lang: 'ar', group: "ar_adhkar", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single2/ar-eidat-alsaabirin-wadhakhirat-alshaakirin.pdf", page: "https://islamhouse.com/ar/books/2841153/", desc: "كتاب يتناول فضل الصبر والشكر معتمداً على نصوص من القرآن الكريم والأحاديث النبوية وآثار السلف." },
        { id: 2841143, name: "الوابل الصيب من الكلم الطيب", lang: 'ar', group: "ar_adhkar", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single2/ar-alwabil-alsiyb-min-alkalm-altayib.pdf", page: "https://islamhouse.com/ar/books/2841143/", desc: "يدور موضوع هذا الكتاب على بيان فضل ذكر الله - عز وجل -، وعظيم أثره وفائدته، وجليل مكانته ومنزلته، ورفيع مقامه ودرجته، وجزيل الثواب المعد لأهله، المتصفين به، في الاخرة والأولى" },
        { id: 2807403, name: "الأذكار والآداب", lang: 'ar', group: "ar_adhkar", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_010/ar-2807403-pp-athkaar.pdf", page: "https://islamhouse.com/ar/books/2807403/", desc: "كتاب قيّم للدكتور عبد المحسن القاسم، جمع فيه الأحاديث الصحيحة المتعلقة بالآداب والأذكار، وقد اجتهد في تبوبيها، وترتيبها، وقد قسم الكتاب إلى قسمين : قسم للآداب، وقسم للأذكار." },
        { id: 2828164, name: "حديث الصباح", lang: 'ar', group: "ar_adhkar", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_02/ar-7adith-elsaba7.pdf", page: "https://islamhouse.com/ar/books/2828164/", desc: "حديث الصباح : هذا الكتاب اشتمل على محاضرات وكلمات كان يلقيها الشيخ ابن باز - رحمه الله -، تضمنت تفسير بعض الآيات، وشرح بعض الأحاديث، وتعليقات على موضوعات متنوعة، وتعليقات على كلمات كان يلقيها بعض المش" },
      ]},
      { id: "ar_arabic", icon: "fa-language", color: "#2E5B32", name: {"ar": "اللغة والنحو والتجويد", "es": "Lengua árabe y recitación", "en": "Arabic & Tajweed"}, books: [
        { id: 2826479, name: "المناهج الدراسية - النحو والصرف - عربي", lang: 'ar', group: "ar_arabic", pdf: "https://d1.islamhouse.com/data/ar/ih_books/chain/ar_almanaheg_alta3elemeah/ar_01_alna7o_wa_alsarf.pdf", page: "https://islamhouse.com/ar/books/2826479/", desc: "كتاب عبارة عن تهذيب واختصار لمنهج النحو والصرف، وهو ضمن المناهج الدراسية في المملكة العربية السعودية الموجهة للطلاب، وتم التعديل عليها يسيرًا بحيث يمكن الاستفادة منها في أي مكان، وهي مُقسمة إلى ستَّة " },
        { id: 2826476, name: "المناهج الدراسية - أحكام التجويد - عربي", lang: 'ar', group: "ar_arabic", pdf: "https://d1.islamhouse.com/data/ar/ih_books/chain/ar_almanaheg_alta3elemeah/ar_01_eltajweed.pdf", page: "https://islamhouse.com/ar/books/2826476/", desc: "كتاب عبارة عن تهذيب واختصار لمنهج أحكام التجويد، وهو ضمن المناهج الدراسية في المملكة العربية السعودية الموجهة للطلاب، وتم التعديل عليها يسيرًا بحيث يمكن الاستفادة منها في أي مكان، وهي مُقسمة إلى ست (6" },
      ]},
      { id: "ar_family", icon: "fa-people-roof", color: "#403277", name: {"ar": "الأسرة وتربية الأطفال", "es": "La mujer, la familia y los niños", "en": "Family & children"}, books: [
        { id: 2831761, name: "هيا بنا نتعلم", lang: 'ar', group: "ar_family", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_01/ar-come-lets-play.pdf", page: "https://islamhouse.com/ar/books/2831761/", desc: "هيا بنا نتعلم: كتاب باللغة العربية، ألفه الشيخ الدكتور هيثم سرحان، يهدف إلى تعليم الطفل المسلم مبادئ الدين والأخلاق والآداب الإسلامية من خلال أسلوب ممتع وشيق، جمع بين موثوقية المعلومة والالتزام بالضوا" },
        { id: 2828180, name: "مفاسد المغالاة في المهور", lang: 'ar', group: "ar_family", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_02/ar-mufasid-almughalat-fi-almuhuir.pdf", page: "https://islamhouse.com/ar/books/2828180/", desc: "مفاسد المغالاة في المهور : كتيب لفضيلة الشيخ محمد بن إبراهيم بن عبد اللطيف، وفضيلة الشيخ عبد العزيز بن باز - رحمهما الله -، نصحا فيه الآباء وأولياء الأمور أن لا يغالوا في المهور من أجل مساعدة الشباب ع" },
        { id: 420135, name: "أصول الكمال الإنساني", lang: 'ar', group: "ar_family", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single7/ar_asul_AlKmal_AlInsany.pdf", page: "https://islamhouse.com/ar/books/420135/", desc: "كتيب يبين أصول الكمال الإنساني وفق ما جاء في سورة العصر." },
        { id: 420133, name: "الرحمة بالأطفال من المنظور الشرعي", lang: 'ar', group: "ar_family", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single7/ar_ArR7mt_balatfal.pdf", page: "https://islamhouse.com/ar/books/420133/", desc: "فإن الرحمة خلق عظيم وطبع نبيل لا يتصف بها إلا العظماء، ولا يتخلى عنها إلا الجبابرة الأذلاء؛ ولذا فقد اتصف الرب - جل وعلا - بها، وبها اتصف المصطفى - صلى الله عليه وسلم - وكانت سمة بارزة في دين الحنيفية" },
      ]},
      { id: "ar_ramadan", icon: "fa-moon", color: "#8E6C10", name: {"ar": "رمضان والصيام", "es": "Ramadán y el ayuno", "en": "Ramadan & fasting"}, books: [
        { id: 193660, name: "زكاة الفطر في ضوء الكتاب والسنة", lang: 'ar', group: "ar_ramadan", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single4/ar_Zakaat_al_Fitr.pdf", page: "https://islamhouse.com/ar/books/193660/", desc: "زكاة الفطر في ضوء الكتاب والسنة: قال المصنف - حفظه الله -: «فهذه رسالة مختصرة في زكاة الفطر بيَّنتُ فيها مفهوم زكاة الفطر: لغةً، واصطلاحًا، وأن الأصل في وجوبها عموم الكتاب، والسنة الصريحة، وإجماع أهل " },
        { id: 193656, name: "زكاة عروض التجارة والأسهم والسندات في ضوء الكتاب والسنة", lang: 'ar', group: "ar_ramadan", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single4/ar_Zakah_Trade.pdf", page: "https://islamhouse.com/ar/books/193656/", desc: "زكاة عروض التجارة والأسهم والسندات في ضوء الكتاب والسنة: قال المصنف - حفظه الله -: «فهذه رسالة مختصرة في «زكاة العروض التجارية والأسهم والسندات» بيَّنت فيها بإيجاز: مفهوم العروض: لغةً, واصطلاحًا، وذكر" },
        { id: 193651, name: "زكاة بهيمة الأنعام السائمة في ضوء الكتاب والسنة", lang: 'ar', group: "ar_ramadan", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single4/ar_Zakat_beast_cattle_grazing.pdf", page: "https://islamhouse.com/ar/books/193651/", desc: "زكاة بهيمة الأنعام السائمة في ضوء الكتاب والسنة: قال المصنف - حفظه الله -: «فهذه رسالة مختصرة في «زكاة بهيمة الأنعام» من الإبل، والبقر، والغنم، التي أنعم الله بـها على عباده؛ ليعبدوه، ويشكروه، بيَّنت " },
        { id: 193650, name: "منزلة الزكاة في الإسلام في ضوء الكتاب والسنة", lang: 'ar', group: "ar_ramadan", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single4/ar_Status_of_Zakah_in_Islam.pdf", page: "https://islamhouse.com/ar/books/193650/", desc: "منزلة الزكاة في الإسلام في ضوء الكتاب والسنة: قال المُصنِّف - حفظه الله -: «فهذه رسالة مختصرة في «منزلة الزكاة في الإسلام» بيَّنت فيها بإيجاز: مفهوم الزكاة: لغة، وشرعًا، وأنواعها، ومكانة الزكاة في الإ" },
        { id: 2828215, name: "أياما معدودات", lang: 'ar', group: "ar_ramadan", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_02/ar-ayaamanaan-mae3dudat.pdf", page: "https://islamhouse.com/ar/books/2828215/", desc: "أياما معدودات : كتاب نافع لفضيلة الشيخ فهد بن يحيي العماري - أثابه الله - عبارة عدة رسائل نافعة ضمت مجموعة من الفوائد والتوجيهات والنصائح بشأن اغتنام فرص الخير وصوالح الأعمال خلال شهر رمضان، وقد جاءت " },
        { id: 2828210, name: "خالصُ الجُمان في اغتنام رمضان", lang: 'ar', group: "ar_ramadan", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_02/ar-eghtenam-ramadan.pdf", page: "https://islamhouse.com/ar/books/2828210/", desc: "كتاب نافع يضم عدة رسائل نافعة ضمت مجموعة من الفوائد والتوجيهات والنصائح بشأن اغتنام فرص الخير وصالح الأعمال خلال شهر رمضان؛ حيث نوَّع الكاتب خواطره وتوجيهاته ما بين النثر والشعر في تقابل بديع للترويح " },
        { id: 2828190, name: "زاد الصائم", lang: 'ar', group: "ar_ramadan", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_01/ar-zad-alsayem-new.pdf", page: "https://islamhouse.com/ar/books/2828190/", desc: "زاد الصائم : كتاب باللغة العربية؛ اشتمل على مسائل متعلقة بشروط الصيام وواجباته وأحكام المفطرين، مع بيان وقت الإمساك والفطر، والمفطرات ونوازلها، وأحكام الصوم في السفر، وصيام القضاء والتطوع، ثم بيان بعض" },
        { id: 2828181, name: "من أعمال رمضان", lang: 'ar', group: "ar_ramadan", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_02/ar-min-a3mal-ramadan.pdf", page: "https://islamhouse.com/ar/books/2828181/", desc: "كتيب لسماحة الشيخ عبد العزيز بن باز رحمه الله، يُبيّن فيه بعض أعمال شهر رمضان، مثل: صلاة القيام - العمرة - الاعتكاف - ختم القرآن - وفضل ليلة القدر." },
        { id: 2828163, name: "النصح والتذكير بفريضة الزكاة", lang: 'ar', group: "ar_ramadan", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_02/ar-alnash-waltadhkir-bifaridat-alzaka.pdf", page: "https://islamhouse.com/ar/books/2828163/", desc: "النصح والتذكير بفريضة الزكاة : كتاب نافع لسماحة الشيخ عبد العزيز بن باز - رحمه الله -، يبين فيه أهمية فريضة الزكاة، وما يتعلق بها من أحكام، ومسائل في صرف الزكاة وأحكامها، وغيرها من المسائل الهامة." },
        { id: 2828092, name: "الدرر البهية من الفوائد البازية - كتاب الصيام -", lang: 'ar', group: "ar_ramadan", pdf: "https://d1.islamhouse.com/data/ar/ih_books/single_09/ar-aldorar-elbaziah-elsyam.pdf", page: "https://islamhouse.com/ar/books/2828092/", desc: "الدرر البهية من الفوائد البازية : كتاب عبارة عن سلسلة من المحاضرات الصوتية، من تعليقات سماحة الشيخ عبد العزيز بن عبد الله بن باز - رحمه الله - على كتاب الصوم؛ في كل بعض مصنفات متون الحديث." },
      ]},
    ]},
