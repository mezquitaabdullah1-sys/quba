  // v1.0.86 — أُزيل 'basics' (Fundamentos del Islam) لأنه كان يكرّر محتوى «مسلمون جدد» (nm).
  ESEN_TOPICS: ['nm', 'aqeedah', 'quran', 'hadith', 'fiqh', 'family', 'kids', 'seerah', 'dialogue', 'reflect'],
  // أبواب المشكاة العربية: id + الاسم + الأيقونة + اللون (بلا تكرار مع TILES)
  topicsFor(lang) {
    if (lang === 'ar') {
      const ih = this.ihGroups('ar').map(g => ({
        id: g.id, topic: g.id, key: null, group: g.id,
        icon: g.icon || this._IH_ICON[g.id] || 'fa-book',
        color: g.color || this._IH_COLOR[g.id] || '#0F4C3A',
        label: this.ihLabel(g.id),
      }));
      const tt = this.AR_TOPICS.map(id => {
        const t = this.TILES.find(x => x.id === id) || this.CATEGORIES.find(x => x.id === id);
        return t ? { id: id, topic: id, key: t.key, icon: t.icon, color: t.color } : null;
      }).filter(Boolean);
      return ih.concat(tt);
    }
    return this.ESEN_TOPICS.map(id => ({
      id: id, topic: id, key: null, group: id,
      icon: (this._IH_ICON[id] || 'fa-book'), color: (this._IH_COLOR[id] || '#0F4C3A'),
      label: this.ihLabel(id),
    }));
  },
  _IH_ICON: { nm:'fa-seedling', basics:'fa-book-open', aqeedah:'fa-star-and-crescent', quran:'fa-book-quran', hadith:'fa-quote-right', fiqh:'fa-scale-balanced', family:'fa-people-roof', kids:'fa-child-reaching', seerah:'fa-book', dialogue:'fa-comments', reflect:'fa-feather-pointed' },
  _IH_ICON_AR: { ar_nm:'fa-seedling', ar_dawah:'fa-bullhorn', ar_aqeedah:'fa-star-and-crescent', ar_quran:'fa-book-quran', ar_hadith:'fa-quote-right', ar_fiqh:'fa-scale-balanced', ar_usul:'fa-gavel', ar_seerah:'fa-book', ar_adhkar:'fa-heart', ar_arabic:'fa-language', ar_family:'fa-people-roof', ar_ramadan:'fa-moon' },
  _IH_COLOR: { nm:'#0F4C3A', basics:'#0E6B5C', aqeedah:'#6D4C41', quran:'#251C4E', hadith:'#14243F', fiqh:'#0A453F', family:'#5A1A1E', kids:'#2E5B32', seerah:'#16341A', dialogue:'#403277', reflect:'#8A6720' },
  _IH_COLOR_AR: { ar_nm:'#0F4C3A', ar_dawah:'#8A6720', ar_aqeedah:'#6D4C41', ar_quran:'#251C4E', ar_hadith:'#14243F', ar_fiqh:'#0A453F', ar_usul:'#3E2723', ar_seerah:'#16341A', ar_adhkar:'#5A1A1E', ar_arabic:'#2E5B32', ar_family:'#403277', ar_ramadan:'#8E6C10' },
  ihGroupBooks(lang, groupId) { const g = this.ihGroups(lang).find(x => x.id === groupId); return g ? g.books : []; },
  ihGroupIcon(groupId) { return this._IH_ICON[groupId] || 'fa-book'; },
  ihGroupColor(groupId) { return this._IH_COLOR[groupId] || '#0F4C3A'; },
  // أبواب الأطفال: للأطفال (مبسّط) وللآباء (تربية ومراجع)
  KIDS_PARENTS_AR: [
    { id: 31321, cat: 'kids', name: 'كيف تربي ولدك', author: 'ليلى الجريبة', catId: 23, pages: 101 },
    { id: 30935, cat: 'kids', name: 'سلسلة أهل الذكر', author: 'شريفة سلامة أبو مريفة', catId: 23, pages: 149 },
    { id: 334, cat: 'kids', name: 'إرشاد الأنام إلى أصول ومهمات دين الإسلام', author: 'عمر العمر', catId: 36, pages: 95 },
    { id: 293, cat: 'kids', name: 'مائة من عظماء أمة الإسلام غيروا مجرى التاريخ', author: 'جهاد الترباني', catId: 26, pages: 455 },
  ],
  KIDS_CHILDREN_AR: [
    { id: 14132, cat: 'kids', name: 'مائة من عظماء أمة الإسلام غيروا مجرى التاريخ', author: 'جهاد الترباني', catId: 26, pages: 455 },
    { id: 9914, cat: 'kids', name: 'السيرة النبوية لأبي الحسن الندوي', author: 'أبو الحسن الندوي', catId: 24, pages: 0 },
    { id: 7690, cat: 'kids', name: 'قصة موسى والخضر', author: 'أبو إسحاق الحويني', catId: 25, pages: 0 },
  ],

  cat(catId) { return this.CATEGORIES.find(c => c.catId === catId) || null; },
  catById(id) { return this.CATEGORIES.find(c => c.id === id) || null; },
  catLabel(cat) { return cat ? this.L(cat.key) : ''; },
  catColor(catId) { const c = this.cat(catId); return c ? c.color : '#0F4C3A'; },
  catByName(name) { const s = String(name || ''); return this.CATEGORIES.find(c => s.indexOf(c.id) !== -1) || null; },
  featuredByCat(catId) { const c = this.cat(catId); return c ? this.FEATURED.filter(b => b.cat === c.id) : []; },
  featuredById(id) { return this.FEATURED.find(b => b.id === Number(id)) || null; },
  // أقسام حسب معرّف القسم (لمربّعات الرئيسية): تُرجع كتب القسم المختارة أو كلّها
  featuredForSection(catId) { const c = this.cat(catId); return c ? this.FEATURED.filter(b => b.cat === c.id) : []; },
};

