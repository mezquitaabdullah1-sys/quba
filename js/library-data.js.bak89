          { id: 818737, name: "Fundamentos del Sendero Profético", lang: 'es', group: "nm", pdf: "https://d1.islamhouse.com/data/es/ih_books/single/es_Fundamentos_del_Sendero_Imam_Ahmad.pdf", page: "https://islamhouse.com/es/books/818737/", desc: "El tema principal de esta clásica obra, el credo islámico (ʿaqīdah), se centra en el estudio de las doctrinas del Islām y en consecuencia de las creencias que todo aquel que se denomina muslim –someti" },
          { id: 2839197, name: "Características de la legislación islámica_ 60 características", lang: 'es', group: "nm", pdf: "https://d1.islamhouse.com/data/es/ih_books/single/es-caracteristicas-legislacion.pdf", page: "https://islamhouse.com/es/books/2839197/", desc: "Este es un libro que explica las características que distinguen a la legislación islámica de otras legislaciones, ya sean las legislaciones divinas que se han perdido, o las legislaciones que han sido" },
