  islamhouse(lang) { return this.ISLAMHOUSE[lang] || { groups: [] }; },
  ihGroups(lang) { return (this.ISLAMHOUSE[lang] || { groups: [] }).groups || []; },
  ihLabel(id) {
    const l = (typeof currentLocale !== 'undefined' && currentLocale) || 'es';
    const g = this.ihGroups('ar').concat(this.ihGroups('es'), this.ihGroups('en')).find(x => x.id === id);
    if (g && g.name) return g.name[l] || g.name.ar || g.name.es || g.name.en || String(id);
    const t = this.IH_GROUP_LABELS[id];
    return t ? (t[l] || t.es || t.ar) : String(id || '');
  },
  tr(obj) {
    const l = (typeof currentLocale !== 'undefined' && currentLocale) || 'es';
    return obj ? (obj[l] || obj.es || obj.ar || '') : '';
  },
  t(key) {
    const l = (typeof currentLocale !== 'undefined' && currentLocale) || 'es';
    const o = this[key]; return o ? (o[l] || o.es || o.ar || '') : key;
  },

  // ============ مساعدات ============
  L(key, vars) {
    const l = (typeof currentLocale !== 'undefined' && currentLocale) || 'es';
    const loc = this.LOCALES[l] ? l : 'es';
    let s = (this.LOCALES[loc] && this.LOCALES[loc][key]) || this.LOCALES.es[key] || this.LOCALES.ar[key] || key;
    if (vars) for (const k in vars) s = s.replace('{' + k + '}', vars[k]);
    return s;
  },

